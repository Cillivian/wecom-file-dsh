{
  "name": "dsh-scratch-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle": "/Users/cillivian/Documents/deepseek-harness/node_modules/.bin/tsdown --config tsdown.config.ts --root /Users/cillivian/Documents/workspace/dsh --tsconfig tsconfig.client.json",
    "web": "cd /Users/cillivian/Documents/deepseek-harness && pnpm dsh web --patch /Users/cillivian/Documents/workspace/dsh/cordis.yml --trusted-host doc.weixin.qq.com --no-open",
    "proxy": "node ./dev-proxy.mjs"
  },
  "exports": {
    ".": "./src/my-plugin.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "@tencent/wedocs-icons": "^0.3.26091100"
  }
}
